---
import type { Evidence } from '../lib/types';
interface Props { evidenceIds: string[]; evidences: Evidence[]; }
const { evidenceIds, evidences } = Astro.props;
const referenced = evidenceIds.map(id => evidences.find(ev => ev.id === id)).filter(Boolean) as Evidence[];
const numberFor = (id: string) => evidences.findIndex(ev => ev.id === id) + 1;
---

{referenced.length > 0 && <sup class="evidence-refs">{referenced.map((ev, index) => <Fragment>{index > 0 && ','}<a href={`#${ev.id}`} title={ev.claim}>[{numberFor(ev.id)}]</a></Fragment>)}</sup>}

<style>
  .evidence-refs { margin-left: .2rem; font-weight: 700; white-space: nowrap; }
  .evidence-refs a { color: var(--amber-dark); text-decoration: none; font-size: .72rem; }
  .evidence-refs a:hover { text-decoration: underline; }
</style>
