---
import type { ComparisonDimension, DecisionDimension } from '../lib/types';
import type { Evidence } from '../lib/types';
import Sources from './Sources.astro';
interface Props { dimensions: ComparisonDimension[] | DecisionDimension[]; label1: string; label2: string; evidences: Evidence[]; }
const { dimensions, label1, label2, evidences } = Astro.props;
---

<div class="comparison-wrapper" tabindex="0" role="region" aria-label="Tabela comparativa com rolagem horizontal em telas pequenas">
  <table class="comparison-table">
    <thead><tr><th>Critério</th><th>{label1}</th><th>{label2}</th></tr></thead>
    <tbody>
      {dimensions.map(dim => (
        <tr>
          <th>{dim.label}<Sources evidenceIds={dim.evidenceIds} evidences={evidences} /></th>
          <td class:list={{ winner: dim.winner === 1 }}><span>{'brand1' in dim ? dim.brand1 : dim.option1}</span>{dim.winner === 1 && <b>Vantagem</b>}</td>
          <td class:list={{ winner: dim.winner === 2 }}><span>{'brand2' in dim ? dim.brand2 : dim.option2}</span>{dim.winner === 2 && <b>Vantagem</b>}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .comparison-wrapper { overflow-x: auto; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
  .comparison-table { width: 100%; min-width: 690px; border-collapse: collapse; }
  .comparison-table th, .comparison-table td { padding: 1rem .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .comparison-table thead th { background: var(--ink); color: var(--paper); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
  .comparison-table thead th:first-child { color: var(--amber); }
  .comparison-table tbody th { width: 28%; font-size: .78rem; color: var(--steel); text-transform: uppercase; letter-spacing: .035em; }
  .comparison-table td { width: 36%; color: var(--ink); line-height: 1.55; }
  .comparison-table tbody tr:nth-child(even) { background: rgba(255,255,255,.28); }
  .comparison-table td b { display: block; width: max-content; margin-top: .45rem; color: var(--amber-dark); font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; border-bottom: 2px solid var(--amber); }
  .comparison-table td.winner { box-shadow: inset 3px 0 0 var(--amber); }
  @media (max-width: 700px) { .comparison-wrapper { margin-right: -1rem; padding-right: 1rem; } }
</style>
