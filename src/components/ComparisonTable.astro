---
import type { ComparisonDimension, DecisionDimension } from '../lib/types';

interface Props {
  dimensions: ComparisonDimension[] | DecisionDimension[];
  label1: string;
  label2: string;
}

const { dimensions, label1, label2 } = Astro.props;
---

<table class="comparison-table">
  <thead>
    <tr>
      <th>Dimensão</th>
      <th>{label1}</th>
      <th>{label2}</th>
    </tr>
  </thead>
  <tbody>
    {dimensions.map(dim => (
      <tr>
        <td class="dimension-label">{dim.label}</td>
        <td class:list={{'winner': dim.winner === 1}}>
          {'brand1' in dim ? dim.brand1 : dim.option1}
          {dim.winner === 1 && <span class="winner-badge">✓</span>}
        </td>
        <td class:list={{'winner': dim.winner === 2}}>
          {'brand2' in dim ? dim.brand2 : dim.option2}
          {dim.winner === 2 && <span class="winner-badge">✓</span>}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 0.75rem 1rem;
    border: 1px solid #e5e7eb;
    text-align: left;
  }

  .comparison-table th {
    background-color: #f9fafb;
    font-weight: 600;
  }

  .dimension-label {
    font-weight: 500;
  }

  .winner {
    background-color: #f0fdf4;
    font-weight: 500;
  }

  .winner-badge {
    color: #16a34a;
    margin-left: 0.5rem;
  }
</style>
