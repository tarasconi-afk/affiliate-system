---
// GLOBAL_INLINE_CITATION_STRATEGY_V2: substitui os marcadores numericos [N]
// (inline no corpo E nos proprios resumos de fonte) por um link direto pelo
// NOME da fonte. evidenceId continua existindo como id de ancora interna
// (fragment da URL, nunca exibido como numero na tela) -- rastreabilidade
// preservada sem nenhum digito visivel em lugar nenhum da pagina publica.
import type { Evidence } from '../lib/types';
interface Props { evidenceIds: string[]; evidences: Evidence[]; label?: string; }
const { evidenceIds, evidences, label } = Astro.props;
const uniqueIds = [...new Set(evidenceIds)];
const referenced = uniqueIds
  .map((id) => evidences.find((ev) => ev.id === id))
  .filter((ev): ev is Evidence => Boolean(ev));
---

{referenced.length > 0 && (
  <details class="section-sources">
    <summary>{label ?? 'Ver fontes desta seção'} ({referenced.length})</summary>
    <ul>
      {referenced.map((ev) => (
        <li><a href={`#${ev.id}`}>{ev.source_name}</a></li>
      ))}
    </ul>
  </details>
)}

<style>
  .section-sources { margin-top: 1.1rem; font-size: .76rem; }
  .section-sources summary { cursor: pointer; color: var(--steel); font-weight: 700; letter-spacing: .02em; list-style: none; }
  .section-sources summary::-webkit-details-marker { display: none; }
  .section-sources summary::before { content: '＋ '; color: var(--amber-dark); }
  .section-sources[open] summary::before { content: '－ '; }
  .section-sources ul { margin: .5rem 0 0; padding-left: 1.1rem; color: var(--steel); }
  .section-sources li { margin: .2rem 0; }
  .section-sources a { color: var(--amber-dark); font-weight: 700; text-decoration: none; }
  .section-sources a:hover { text-decoration: underline; }
</style>
