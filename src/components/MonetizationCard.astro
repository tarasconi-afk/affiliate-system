---
// MONETIZATION_CARD_V3.2: componente unico para 1 ou 2 produtos (slots) e para
// o banner sazonal -- native commerce MODULE editorial (nao uma tabela de
// metadata, nao uma ferramenta administrativa). Card de produto e banner
// sazonal nunca ficam colados um no outro (controlado por placement em
// ArticleLayout, nao aqui).
//
// PUBLIC_MATCH_AUDIT_DETAILS_VISIBLE=0: matchType/matchEvidence/trackingSource
// /matchedAt (AffiliateMatch) e o offer.disclaimer de auditoria NUNCA sao
// renderizados como texto visivel aqui -- continuam existindo no PageSpec (o
// Admin le e edita esses campos normalmente), so nao aparecem para o leitor.
import type { AffiliateOffer } from '../lib/types';

interface ProductProps {
  variant: 'product';
  offers: AffiliateOffer[]; // 1 ou 2
}
interface SeasonalProps {
  variant: 'seasonal';
  seasonalHref: string;
  seasonalLabel?: string;
  // SEASONAL_RUNTIME_EXPIRY_V1: envelope mais largo entre as fontes
  // divergentes (ver getDisplayWindow em lib/seasonal_events.ts). O card nasce
  // `hidden` no HTML e só aparece se o relogio do NAVEGADOR estiver dentro
  // desta janela -- fail-closed se JS falhar ou a janela ja tiver passado.
  windowStartsAt: string;
  windowEndsAt: string;
}
type Props = ProductProps | SeasonalProps;

const props = Astro.props;
const offers = props.variant === 'product' ? props.offers.filter((o) => o.enabled !== false) : [];

function slotAriaLabel(offer: AffiliateOffer): string {
  return offer.ctaText || offer.label || 'Ver produto na Amazon';
}
---

{props.variant === 'product' && offers.length > 0 && (
  <section class:list={['mc-card', 'mc-product', { 'mc-two': offers.length === 2 }]} aria-label="Onde comprar">
    <p class="mc-eyebrow">ONDE COMPRAR</p>
    <div class="mc-slots">
      {offers.map((offer) => (
        <div class="mc-slot">
          <div class="mc-thumb-wrap">
            <div class="mc-thumb" aria-hidden="true">
              {offer.imageUrl
                ? <img src={offer.imageUrl} alt="" loading="lazy" />
                : (
                  <svg class="mc-placeholder-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="30" fill="var(--paper)" />
                    <circle cx="32" cy="32" r="29.25" stroke="var(--amber)" stroke-width="1.5" opacity=".55" />
                    <path d="M23 41l15-15M34 19l11 11-5.5 5.5L28.5 24.5 34 19z" stroke="var(--ink-soft)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="21.5" cy="42.5" r="3.4" stroke="var(--ink-soft)" stroke-width="2.4" />
                  </svg>
                )}
            </div>
            {offer.imageUrl && offer.imageSourceType === 'EDITORIAL_LOCAL' && (
              <p class="mc-img-caption">Imagem ilustrativa</p>
            )}
          </div>
          <div class="mc-copy">
            <p class="mc-name">{offer.label ?? 'Ver na Amazon'}</p>
            {offer.contextLine && <p class="mc-context">{offer.contextLine}</p>}
            <a class="mc-cta" href={offer.affiliateUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" aria-label={slotAriaLabel(offer)}>Ver na Amazon →</a>
          </div>
        </div>
      ))}
    </div>
    <p class="mc-micro-disclosure">* Link de afiliado.</p>
  </section>
)}

{props.variant === 'seasonal' && (
  <section class="mc-card mc-seasonal" hidden data-seasonal-starts={props.windowStartsAt} data-seasonal-ends={props.windowEndsAt} aria-label="Oferta sazonal">
    <div class="mc-seasonal-body">
      <p class="mc-eyebrow mc-eyebrow-light">MEGA OFERTA PRIME</p>
      <p class="mc-seasonal-copy">{props.seasonalLabel ?? 'Confira as ofertas da campanha atual na Amazon.'}</p>
      <a class="mc-cta mc-cta-outline" href={props.seasonalHref} target="_blank" rel="noopener noreferrer nofollow sponsored">Ver ofertas →</a>
    </div>
    <p class="mc-micro-disclosure mc-micro-disclosure-light">* Link de afiliado.</p>
  </section>
)}

{props.variant === 'seasonal' && (
  <script is:inline define:vars={{ starts: props.windowStartsAt, ends: props.windowEndsAt }}>
    // SEASONAL_RUNTIME_EXPIRY_V1: unica fonte de verdade sobre mostrar/ocultar
    // o CTA sazonal e o relogio do navegador NO MOMENTO EM QUE A PAGINA E
    // ABERTA, nunca o build. Fail-closed: qualquer excecao aqui dentro deixa o
    // elemento no estado `hidden` em que ele nasceu no HTML.
    try {
      var el = document.currentScript.previousElementSibling;
      var now = new Date();
      var start = new Date(starts);
      var end = new Date(ends);
      if (now >= start && now <= end) {
        el.hidden = false;
      }
    } catch (e) { /* fail-closed: permanece hidden */ }
  </script>
)}

<style>
  .mc-card {
    margin: 3rem 0;
    padding: 1.9rem 2rem 1.7rem;
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-top: 3px solid var(--amber);
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(20, 20, 20, .04), 0 6px 18px rgba(20, 20, 20, .05);
  }
  [hidden] { display: none !important; }
  .mc-eyebrow { margin: 0 0 1.1rem; color: var(--amber-dark); font-size: .64rem; font-weight: 900; letter-spacing: .16em; }

  .mc-slots { display: grid; grid-template-columns: 1fr; gap: 1.6rem; }
  .mc-two .mc-slots { grid-template-columns: 1fr 1fr; }
  .mc-slot { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .9rem; }

  .mc-thumb-wrap { display: grid; gap: .4rem; justify-items: center; }
  .mc-thumb {
    width: 132px; height: 132px;
    display: flex; align-items: center; justify-content: center;
    background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    overflow: hidden; color: var(--steel);
  }
  .mc-two .mc-thumb { width: 104px; height: 104px; }
  .mc-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .mc-placeholder-icon { width: 100%; height: 100%; }
  .mc-img-caption { margin: 0; font-size: .64rem; color: var(--steel); font-style: italic; }

  .mc-copy { display: grid; gap: .4rem; min-width: 0; width: 100%; justify-items: center; }
  .mc-name { margin: 0; font-weight: 800; font-size: 1rem; color: var(--ink); line-height: 1.3; }
  .mc-context {
    margin: 0; font-size: .82rem; color: var(--muted); line-height: 1.4;
    max-width: 38ch;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .mc-cta {
    display: inline-block; width: max-content; margin-top: .35rem;
    background: var(--ink); color: var(--paper);
    padding: .75rem 1.5rem; border-radius: 6px;
    font-size: .85rem; font-weight: 800; text-decoration: none;
    transition: background-color .15s ease;
  }
  .mc-cta:hover { background: var(--amber-dark); }
  .mc-cta:focus-visible { outline: 2px solid var(--amber-dark); outline-offset: 2px; }
  .mc-cta-outline { background: transparent; color: var(--paper); border: 2px solid var(--paper); }
  .mc-cta-outline:hover { background: var(--paper); color: var(--ink); }

  .mc-seasonal {
    background: var(--ink); border-color: var(--ink); border-top-color: var(--amber);
    box-shadow: 0 6px 20px rgba(0, 0, 0, .18);
  }
  .mc-eyebrow-light { color: var(--amber); }
  .mc-seasonal-body { display: grid; gap: .7rem; }
  .mc-seasonal-copy { margin: 0; font-size: 1rem; line-height: 1.55; color: #d5d7d6; max-width: 52ch; }
  .mc-micro-disclosure-light { color: #9aa0a3; }

  .mc-micro-disclosure { margin: 1.3rem 0 0; font-size: .7rem; color: var(--steel); }

  @media (max-width: 700px) {
    .mc-card { padding: 1.6rem 1.4rem; }
    .mc-two .mc-slots { grid-template-columns: 1fr; gap: 2rem; }
    .mc-thumb { width: 112px; height: 112px; }
    .mc-two .mc-thumb { width: 112px; height: 112px; }
  }
</style>
