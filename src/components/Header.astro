---
// Header compacto editorial
---

<header class="site-header">
  <div class="header-container">
    <div class="logo">
      <a href="/">
        <span class="logo-text">ToolCompare</span>
      </a>
    </div>
    <nav class="nav">
      <a href="/">Comparações</a>
      <a href="/#metodologia">Metodologia</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #1e293b;
    border-bottom: 3px solid #fbbf24;
    margin-bottom: 3rem;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #fbbf24;
  }

  @media (max-width: 640px) {
    .header-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.875rem 1.5rem;
    }

    .logo a {
      font-size: 1.25rem;
    }

    .nav {
      gap: 1.5rem;
    }
  }
</style>
