---
import { SITE } from '../lib/site';
---

<header class="site-header">
  <div class="masthead">
    <a class="brand" href="/" aria-label={`${SITE.name} — página inicial`}>
      <img src="/brand/ferramenta-clara-mark.svg" alt="" width="34" height="34" />
      <span class="brand-type">
        <span>FERRAMENTA</span>
        <strong>CLARA</strong>
      </span>
    </a>

    <nav aria-label="Navegação principal">
      <a href="/#comparacoes">Comparações</a>
      <a href="/#metodologia">Metodologia</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid var(--line-dark);
  }

  .masthead {
    max-width: var(--max);
    margin: 0 auto;
    min-height: 76px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand img {
    width: 34px;
    height: 34px;
    color: var(--paper);
  }

  .brand-type {
    display: grid;
    line-height: .9;
    letter-spacing: .045em;
    font-size: .74rem;
  }

  .brand-type strong {
    margin-top: .25rem;
    font-size: 1.1rem;
    letter-spacing: .07em;
    color: var(--paper);
  }

  nav { display: flex; gap: 1.75rem; }

  nav a {
    color: #d9d5cc;
    text-decoration: none;
    font-size: .82rem;
    font-weight: 750;
    letter-spacing: .06em;
    text-transform: uppercase;
    position: relative;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -.4rem;
    height: 2px;
    background: var(--amber);
    transition: right .18s ease;
  }

  nav a:hover::after { right: 0; }

  @media (max-width: 640px) {
    .masthead { min-height: 68px; padding: 0 1rem; }
    nav { gap: 1rem; }
    nav a { font-size: .7rem; }
    .brand-type span { display: none; }
    .brand-type strong { margin: 0; font-size: 1rem; }
  }
</style>
