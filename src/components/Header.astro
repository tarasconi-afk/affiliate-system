---
import { SITE } from '../lib/site';
---

<header class="site-header">
  <div class="masthead">
    <a class="brand" href="/" aria-label={`${SITE.name} — página inicial`}>
      <span class="brand-name"><span>Ferramenta</span><strong>Clara</strong></span>
      <span class="brand-accent" aria-hidden="true"></span>
    </a>

    <nav aria-label="Navegação principal">
      <a href="/#comparacoes">Comparações</a>
      <a href="/#metodologia">Metodologia</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid var(--line-dark);
  }

  .masthead {
    max-width: var(--max);
    margin: 0 auto;
    min-height: 72px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--paper);
    padding: .2rem 0 .45rem;
  }

  .brand-name {
    display: inline-flex;
    align-items: baseline;
    gap: .34rem;
    font-size: 1.05rem;
    letter-spacing: -.035em;
    line-height: 1;
  }

  .brand-name span { font-weight: 560; color: #d4d2cc; }
  .brand-name strong { font-weight: 900; color: var(--paper); }

  .brand-accent {
    position: absolute;
    left: calc(100% - 2.15rem);
    bottom: 0;
    width: 2.15rem;
    height: 3px;
    background: var(--amber);
  }

  nav { display: flex; gap: 1.75rem; }

  nav a {
    color: #d9d5cc;
    text-decoration: none;
    font-size: .8rem;
    font-weight: 750;
    letter-spacing: .06em;
    text-transform: uppercase;
    position: relative;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -.4rem;
    height: 2px;
    background: var(--amber);
    transition: right .18s ease;
  }

  nav a:hover::after { right: 0; }

  @media (max-width: 640px) {
    .masthead { min-height: 64px; padding: 0 1rem; gap: 1rem; }
    .brand-name { font-size: .95rem; }
    nav { gap: .9rem; }
    nav a { font-size: .66rem; letter-spacing: .045em; }
  }
</style>
