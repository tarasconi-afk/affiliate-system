---
// Masthead editorial Ferramenta Clara
---

<header class="site-header">
  <div class="header-container">
    <div class="brand-lockup">
      <a href="/">
        <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="32" height="32" stroke="currentColor" stroke-width="2.5" rx="2"/>
          <path d="M12 12 L12 22 L18 22 M12 17 L17 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/>
          <path d="M22 12 L22 22 M22 12 L28 12 M22 17 L27 17 M22 22 L28 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/>
          <circle cx="20" cy="28" r="1.5" fill="currentColor"/>
        </svg>
        <span class="brand-name">
          <span class="brand-ferramenta">Ferramenta</span>
          <span class="brand-clara">Clara</span>
        </span>
      </a>
    </div>
    <nav class="nav">
      <a href="/">Comparações</a>
      <a href="/#metodologia">Metodologia</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    border-bottom: 2px solid var(--amber);
    margin-bottom: 0;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.125rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-lockup a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--paper);
  }

  .brand-name {
    display: flex;
    gap: 0.375rem;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .brand-ferramenta {
    font-weight: 500;
  }

  .brand-clara {
    font-weight: 700;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    color: var(--paper);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.2s;
    letter-spacing: 0.01em;
  }

  .nav a:hover {
    color: var(--amber);
  }

  @media (max-width: 640px) {
    .header-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
      padding: 1rem 1.5rem;
    }

    .brand-name {
      font-size: 1.125rem;
    }

    .brand-mark {
      width: 28px;
      height: 28px;
    }

    .nav {
      gap: 1.5rem;
    }

    .nav a {
      font-size: 0.875rem;
    }
  }
</style>
