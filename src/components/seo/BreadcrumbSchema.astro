---
import type { Breadcrumb } from '../../lib/types';
import { buildCanonical } from '../../lib/seoHelpers';

interface Props {
  breadcrumbs: Breadcrumb[];
  currentSlug: string;
}

const { breadcrumbs, currentSlug } = Astro.props;
const SITE_URL = import.meta.env.SITE || 'https://example.com';

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": crumb.url
      ? `${SITE_URL}${crumb.url}`
      : (index === breadcrumbs.length - 1 ? buildCanonical(currentSlug) : undefined)
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
