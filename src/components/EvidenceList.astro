---
import type { Evidence } from '../lib/types';
interface Props { evidences: Evidence[]; }
const { evidences } = Astro.props;
const labels: Record<string, string> = { SPEC: 'Fonte primária', DERIVED: 'Análise derivada', OBSERVATION: 'Observação', MEASUREMENT: 'Medição' };
---

<section class="evidence-list" aria-labelledby="fontes-evidencias">
  <div class="evidence-heading">
    <div><p>TRANSPARÊNCIA</p><h2 id="fontes-evidencias">Fontes e evidências</h2></div>
    <span>{evidences.length} referências</span>
  </div>
  <ol>
    {evidences.map((ev, index) => (
      <li id={ev.id}>
        <div class="evidence-index">[{index + 1}]</div>
        <div class="evidence-content">
          <div class="evidence-meta"><span>{labels[ev.evidence_type]}</span><time datetime={ev.accessed_at}>{new Date(ev.accessed_at).toLocaleDateString('pt-BR')}</time></div>
          <p class="claim">{ev.claim}</p>
          <p class="source">{ev.source_url ? <a href={ev.source_url} target="_blank" rel="noopener noreferrer">{ev.source_name}</a> : ev.source_name}</p>
          {ev.notes && <p class="notes">{ev.notes}</p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .evidence-list { margin: 5rem 0 1rem; padding-top: 1.4rem; border-top: 3px solid var(--ink); }
  .evidence-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line); }
  .evidence-heading p { margin: 0 0 .35rem; color: var(--amber-dark); font-size: .64rem; font-weight: 900; letter-spacing: .14em; }
  .evidence-heading h2 { margin: 0; font-size: 1.55rem; }
  .evidence-heading > span { color: var(--steel); font-size: .72rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 52px 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .evidence-index { color: var(--amber-dark); font: 800 .72rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .evidence-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem; color: var(--steel); font-size: .67rem; text-transform: uppercase; letter-spacing: .06em; }
  .claim { margin: .35rem 0 .25rem; color: var(--ink); font-size: .92rem; line-height: 1.55; }
  .source, .notes { margin: 0; font-size: .76rem; line-height: 1.5; }
  .source a { color: var(--ink); font-weight: 700; }
  .notes { margin-top: .45rem; color: var(--steel); }
</style>
