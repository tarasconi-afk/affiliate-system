---
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = [
  {
    title: 'DeWalt DCD777 vale a pena?',
    description: 'Especificações técnicas, características e análise baseada em dados do fabricante.',
    url: '/parafusadeira-dewalt-dcd777-vale-a-pena/',
    type: 'Análise de modelo',
    category: 'ANÁLISE DE PRODUTO'
  },
  {
    title: 'Bosch ou Makita?',
    description: 'Comparação técnica entre as marcas: garantia, linhas de produto e compatibilidade.',
    url: '/bosch-ou-makita-parafusadeira/',
    type: 'Comparação de marcas',
    category: 'COMPARAÇÃO DE MARCAS'
  },
  {
    title: '12V ou 18V?',
    description: 'Diferenças de torque, peso, autonomia e quando escolher cada voltagem.',
    url: '/parafusadeira-12v-ou-18v/',
    type: 'Guia de decisão',
    category: 'GUIA DE DECISÃO'
  }
];
---

<BaseLayout title="Escolha a ferramenta certa com dados, não propaganda">
  <Fragment slot="head">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Comparações e análises de ferramentas elétricas baseadas em especificações técnicas e dados verificáveis." />
    <link rel="canonical" href="https://example.com/" />
  </Fragment>

  <div class="hero">
    <div class="hero-content">
      <h1>Escolha a ferramenta certa com dados, não propaganda</h1>
      <p class="hero-subtitle">
        Comparações e análises baseadas em especificações técnicas, documentação oficial e critérios verificáveis.
      </p>
      <div class="hero-ctas">
        <a href="#comparacoes" class="cta-primary">Ver comparações</a>
        <a href="#metodologia" class="cta-secondary">Como analisamos</a>
      </div>
    </div>
    <div class="hero-visual">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Parafusadeira estilizada -->
        <g transform="translate(50, 60)">
          <!-- Corpo principal -->
          <rect x="20" y="30" width="80" height="50" rx="4" fill="#2563eb" opacity="0.9"/>
          <!-- Mandril -->
          <rect x="95" y="45" width="30" height="20" rx="2" fill="#1e40af"/>
          <circle cx="125" cy="55" r="8" fill="#374151"/>
          <!-- Gatilho -->
          <path d="M 40 80 Q 30 90 35 100 L 45 100 Q 50 90 45 80 Z" fill="#1e40af" opacity="0.8"/>
          <!-- Bateria -->
          <rect x="15" y="80" width="35" height="45" rx="3" fill="#f59e0b"/>
          <rect x="20" y="85" width="25" height="8" rx="1" fill="#374151" opacity="0.3"/>
          <!-- Detalhes -->
          <circle cx="70" cy="50" r="3" fill="#ffffff" opacity="0.4"/>
          <line x1="60" y1="55" x2="85" y2="55" stroke="#ffffff" stroke-width="2" opacity="0.3"/>
        </g>
      </svg>
    </div>
  </div>

  <section id="comparacoes" class="content-cards">
    <h2>Análises e comparações</h2>
    <div class="cards-grid">
      {pages.map(page => (
        <a href={page.url} class="card">
          <span class="card-category">{page.category}</span>
          <h3>{page.title}</h3>
          <p>{page.description}</p>
          <span class="card-cta">Ver análise →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="metodologia" class="methodology">
    <h2>Como analisamos</h2>
    <div class="methodology-content">
      <p class="methodology-intro">
        Comparamos documentação oficial, especificações e dados verificáveis. Quando uma conclusão é nossa,
        mostramos quais dados foram usados para chegar até ela. Não afirmamos ter testado fisicamente um
        produto quando isso não aconteceu.
      </p>

      <div class="methodology-principles">
        <div class="principle">
          <h3>Baseado em dados</h3>
          <p>Utilizamos especificações técnicas de fabricantes e documentação oficial verificável.</p>
        </div>
        <div class="principle">
          <h3>Transparente</h3>
          <p>Cada afirmação relevante aponta para sua fonte. Você pode verificar de onde vem cada informação.</p>
        </div>
        <div class="principle">
          <h3>Honesto</h3>
          <p>Não afirmamos testes que não fizemos. Conclusões derivadas são claramente identificadas.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
      margin-bottom: 5rem;
      padding: 3rem 0;
    }

    .hero-content h1 {
      font-size: 2.75rem;
      line-height: 1.2;
      margin-top: 0;
      margin-bottom: 1.25rem;
      color: #111827;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      line-height: 1.6;
      color: #4b5563;
      margin-bottom: 2rem;
      max-width: 100%;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .cta-primary,
    .cta-secondary {
      padding: 0.875rem 1.75rem;
      font-weight: 600;
      border-radius: 6px;
      transition: all 0.2s;
      font-size: 1rem;
    }

    .cta-primary {
      background: #2563eb;
      color: white;
    }

    .cta-primary:hover {
      background: #1d4ed8;
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .cta-secondary {
      background: #f3f4f6;
      color: #374151;
    }

    .cta-secondary:hover {
      background: #e5e7eb;
      text-decoration: none;
    }

    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-visual svg {
      width: 100%;
      max-width: 300px;
      height: auto;
    }

    .content-cards {
      margin-bottom: 5rem;
    }

    .content-cards h2 {
      font-size: 2rem;
      margin-bottom: 2.5rem;
      margin-top: 0;
      text-align: center;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 2rem;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    .card:hover {
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      border-color: #d1d5db;
      transform: translateY(-2px);
      text-decoration: none;
    }

    .card-category {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      color: #2563eb;
      background: #eff6ff;
      padding: 0.375rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 1.25rem;
      letter-spacing: 0.05em;
      align-self: flex-start;
    }

    .card h3 {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: 1.375rem;
      color: #111827;
      line-height: 1.3;
    }

    .card p {
      color: #6b7280;
      margin-bottom: 1.5rem;
      font-size: 0.95rem;
      line-height: 1.6;
      flex-grow: 1;
    }

    .card-cta {
      color: #2563eb;
      font-weight: 600;
      font-size: 0.95rem;
    }

    .methodology {
      background: #f9fafb;
      padding: 3rem;
      border-radius: 12px;
      margin-bottom: 3rem;
    }

    .methodology h2 {
      margin-top: 0;
      font-size: 2rem;
      text-align: center;
      margin-bottom: 2rem;
    }

    .methodology-intro {
      font-size: 1.125rem;
      line-height: 1.7;
      color: #4b5563;
      text-align: center;
      max-width: 800px;
      margin: 0 auto 3rem;
    }

    .methodology-principles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .principle {
      background: white;
      padding: 1.75rem;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
    }

    .principle h3 {
      margin-top: 0;
      margin-bottom: 0.75rem;
      font-size: 1.125rem;
      color: #111827;
    }

    .principle p {
      color: #6b7280;
      font-size: 0.95rem;
      margin: 0;
      line-height: 1.6;
    }

    @media (max-width: 1024px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }

      .methodology-principles {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 2rem 0;
        margin-bottom: 3rem;
      }

      .hero-content h1 {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1.125rem;
      }

      .hero-visual svg {
        max-width: 200px;
      }

      .content-cards h2,
      .methodology h2 {
        font-size: 1.75rem;
      }

      .methodology {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</BaseLayout>
