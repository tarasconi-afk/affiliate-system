---
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = [
  {
    title: 'DeWalt DCD777 vale a pena?',
    description: 'Especificações técnicas, características e análise baseada em dados do fabricante.',
    url: '/parafusadeira-dewalt-dcd777-vale-a-pena/',
    type: 'Análise de modelo',
    category: 'ANÁLISE DE PRODUTO'
  },
  {
    title: 'Bosch ou Makita?',
    description: 'Comparação técnica entre as marcas: garantia, linhas de produto e compatibilidade.',
    url: '/bosch-ou-makita-parafusadeira/',
    type: 'Comparação de marcas',
    category: 'COMPARAÇÃO DE MARCAS'
  },
  {
    title: '12V ou 18V?',
    description: 'Diferenças de torque, peso, autonomia e quando escolher cada voltagem.',
    url: '/parafusadeira-12v-ou-18v/',
    type: 'Guia de decisão',
    category: 'GUIA DE DECISÃO'
  }
];
---

<BaseLayout title="Escolha a ferramenta certa com dados, não propaganda">
  <Fragment slot="head">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Comparações e análises de ferramentas elétricas baseadas em especificações técnicas e dados verificáveis." />
    <link rel="canonical" href="https://example.com/" />
  </Fragment>

  <div class="hero">
    <div class="hero-content">
      <div class="eyebrow">GUIAS INDEPENDENTES DE FERRAMENTAS</div>
      <h1>Escolha a ferramenta certa com dados, não propaganda</h1>
      <p class="hero-subtitle">
        Análises e comparações baseadas em especificações oficiais, sem marketing ou achismos.
      </p>
      <div class="hero-ctas">
        <a href="#comparacoes" class="cta-primary">Ver análises</a>
        <a href="#metodologia" class="cta-secondary">Como funciona</a>
      </div>
      <div class="hero-pillars">
        Especificações oficiais • Comparações objetivas • Fontes verificáveis
      </div>
    </div>
    <div class="hero-visual">
      <img src="/images/dewalt-20v-cc.jpg" alt="DeWalt 20V cordless drill" loading="eager" width="600" height="400" />
      <p class="image-credit">Foto: TaurusEmerald / <a href="https://commons.wikimedia.org/wiki/File:DeWalt_20_Volt_Max_Cordless_Drill.jpg" target="_blank" rel="noopener">Wikimedia Commons</a> / CC BY-SA 4.0</p>
    </div>
  </div>

  <section id="comparacoes" class="content-cards">
    <h2>Análises em destaque</h2>
    <div class="featured-card">
      <div class="featured-image">
        <img src="/images/dewalt-20v-cc.jpg" alt="DeWalt DCD777 analysis" loading="lazy" width="500" height="333" />
        <p class="image-credit-small">Foto: TaurusEmerald / Wikimedia Commons / CC BY-SA 4.0</p>
      </div>
      <div class="featured-content">
        <span class="card-category">ANÁLISE DE PRODUTO</span>
        <h3>DeWalt DCD777 vale a pena?</h3>
        <p>Especificações técnicas, características e análise baseada em dados do fabricante.</p>
        <a href="/parafusadeira-dewalt-dcd777-vale-a-pena/" class="card-cta">Ler análise completa →</a>
      </div>
    </div>
    <div class="secondary-cards">
      <a href="/bosch-ou-makita-parafusadeira/" class="card-compact">
        <div class="card-compact-image">
          <img src="/images/bosch-makita-cc.jpg" alt="Bosch vs Makita comparison" loading="lazy" width="300" height="200" />
          <p class="image-credit-compact">Foto: Hendrikp111 / Wikimedia Commons / CC BY-SA 4.0</p>
        </div>
        <div class="card-compact-content">
          <span class="card-category">COMPARAÇÃO DE MARCAS</span>
          <h3>Bosch ou Makita?</h3>
          <p>Comparação técnica entre as marcas: garantia, linhas de produto e compatibilidade.</p>
        </div>
      </a>
      <a href="/parafusadeira-12v-ou-18v/" class="card-compact">
        <div class="card-compact-image">
          <img src="/images/bosch-12v-cc.jpg" alt="12V vs 18V decision guide" loading="lazy" width="300" height="200" />
          <p class="image-credit-compact">Foto: Charles & Hudson / Wikimedia Commons / CC BY-SA 2.0</p>
        </div>
        <div class="card-compact-content">
          <span class="card-category">GUIA DE DECISÃO</span>
          <h3>12V ou 18V?</h3>
          <p>Diferenças de torque, peso, autonomia e quando escolher cada voltagem.</p>
        </div>
      </a>
    </div>
  </section>

  <section id="metodologia" class="methodology">
    <h2>Como analisamos</h2>
    <div class="methodology-steps">
      <div class="step">
        <div class="step-number">01</div>
        <div class="step-content">
          <h3>Coletamos especificações oficiais</h3>
          <p>Sites dos fabricantes, manuais técnicos e documentação verificável.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">02</div>
        <div class="step-content">
          <h3>Comparamos diferenças relevantes</h3>
          <p>Torque, autonomia, peso, compatibilidade e garantia com fontes citadas.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">03</div>
        <div class="step-content">
          <h3>Mostramos para quem cada opção faz sentido</h3>
          <p>Sem vencedor universal. Cada ferramenta atende um uso diferente.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: start;
      margin-bottom: 4rem;
      padding: 2rem 0 3rem;
    }

    .eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: #fbbf24;
      margin-bottom: 1rem;
    }

    .hero-content h1 {
      font-size: 2.75rem;
      line-height: 1.1;
      margin-top: 0;
      margin-bottom: 1.25rem;
      color: #111827;
      font-weight: 700;
    }

    .hero-subtitle {
      font-size: 1.125rem;
      line-height: 1.6;
      color: #4b5563;
      margin-bottom: 2rem;
      max-width: 100%;
    }

    .hero-pillars {
      font-size: 0.875rem;
      color: #6b7280;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #e5e7eb;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .cta-primary,
    .cta-secondary {
      padding: 0.875rem 1.75rem;
      font-weight: 600;
      border-radius: 6px;
      transition: all 0.2s;
      font-size: 1rem;
    }

    .cta-primary {
      background: #2563eb;
      color: white;
    }

    .cta-primary:hover {
      background: #1d4ed8;
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .cta-secondary {
      background: #f3f4f6;
      color: #374151;
    }

    .cta-secondary:hover {
      background: #e5e7eb;
      text-decoration: none;
    }

    .hero-visual {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .hero-visual img {
      width: 100%;
      height: auto;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
    }

    .image-credit {
      font-size: 0.75rem;
      color: #9ca3af;
      margin: 0;
    }

    .image-credit a {
      color: #6b7280;
      text-decoration: underline;
    }

    .content-cards {
      margin-bottom: 5rem;
    }

    .content-cards h2 {
      font-size: 2rem;
      margin-bottom: 2.5rem;
      margin-top: 0;
    }

    .featured-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .featured-image img {
      width: 100%;
      height: auto;
      border-radius: 8px;
    }

    .image-credit-small {
      font-size: 0.7rem;
      color: #9ca3af;
      margin-top: 0.5rem;
    }

    .featured-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .secondary-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .card-compact {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 1.25rem;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.5rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s;
    }

    .card-compact:hover {
      box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.1);
      border-color: #d1d5db;
      transform: translateY(-2px);
      text-decoration: none;
    }

    .card-compact-image img {
      width: 100%;
      height: auto;
      border-radius: 6px;
    }

    .image-credit-compact {
      font-size: 0.65rem;
      color: #9ca3af;
      margin-top: 0.35rem;
    }

    .card-category {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      color: #1e293b;
      background: #fbbf24;
      padding: 0.25rem 0.625rem;
      border-radius: 3px;
      margin-bottom: 0.75rem;
      letter-spacing: 0.05em;
      align-self: flex-start;
    }

    .featured-content h3,
    .card-compact-content h3 {
      margin-top: 0;
      margin-bottom: 0.75rem;
      font-size: 1.375rem;
      color: #111827;
      line-height: 1.25;
    }

    .featured-content p,
    .card-compact-content p {
      color: #6b7280;
      margin-bottom: 1.25rem;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .card-cta {
      color: #1e293b;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .methodology {
      background: #1e293b;
      padding: 3.5rem 3rem;
      border-radius: 12px;
      margin-bottom: 3rem;
    }

    .methodology h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 3rem;
      color: #ffffff;
    }

    .methodology-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }

    .step {
      display: flex;
      gap: 1.25rem;
    }

    .step-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #fbbf24;
      line-height: 1;
      flex-shrink: 0;
    }

    .step-content h3 {
      margin-top: 0.25rem;
      margin-bottom: 0.75rem;
      font-size: 1.125rem;
      color: #ffffff;
      font-weight: 600;
    }

    .step-content p {
      color: #cbd5e1;
      font-size: 0.9rem;
      margin: 0;
      line-height: 1.6;
    }

    @media (max-width: 1024px) {
      .secondary-cards {
        grid-template-columns: 1fr;
      }

      .methodology-steps {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 1.5rem 0;
        margin-bottom: 3rem;
      }

      .hero-content h1 {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1rem;
      }

      .featured-card {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .card-compact {
        grid-template-columns: 1fr;
      }

      .content-cards h2,
      .methodology h2 {
        font-size: 1.75rem;
      }

      .methodology {
        padding: 2.5rem 1.5rem;
      }
    }
  </style>
</BaseLayout>
