---
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = [
  {
    title: 'DeWalt DCD777 vale a pena?',
    description: 'Especificações técnicas, características e análise baseada em dados do fabricante.',
    url: '/parafusadeira-dewalt-dcd777-vale-a-pena/',
    type: 'Análise de modelo',
    category: 'ANÁLISE DE PRODUTO'
  },
  {
    title: 'Bosch ou Makita?',
    description: 'Comparação técnica entre as marcas: garantia, linhas de produto e compatibilidade.',
    url: '/bosch-ou-makita-parafusadeira/',
    type: 'Comparação de marcas',
    category: 'COMPARAÇÃO DE MARCAS'
  },
  {
    title: '12V ou 18V?',
    description: 'Diferenças de torque, peso, autonomia e quando escolher cada voltagem.',
    url: '/parafusadeira-12v-ou-18v/',
    type: 'Guia de decisão',
    category: 'GUIA DE DECISÃO'
  }
];
---

<BaseLayout title="Ferramenta Clara — Dados claros para escolher melhor">
  <Fragment slot="head">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Comparações e guias de ferramentas baseados em especificações verificáveis e fontes abertas." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://example.com/" />
  </Fragment>

  <div class="hero">
    <div class="hero-content">
      <div class="eyebrow">GUIAS INDEPENDENTES DE FERRAMENTAS</div>
      <h1>Escolha a ferramenta certa com dados, não propaganda</h1>
      <p class="hero-subtitle">
        Comparações técnicas e guias de decisão baseados em especificações verificáveis e fontes abertas.
      </p>
      <div class="hero-ctas">
        <a href="#comparacoes" class="cta-primary">Ver comparações</a>
        <a href="#metodologia" class="cta-secondary">Como analisamos</a>
      </div>
      <div class="hero-trust">
        Especificações oficiais · Comparações objetivas · Fontes verificáveis
      </div>
    </div>
    <div class="hero-visual">
      <img src="/images/dewalt-20v-cc.jpg" alt="Exemplo de furadeira/parafusadeira DeWalt 20V" loading="eager" width="1200" height="800" />
      <p class="image-credit">Foto: TaurusEmerald / <a href="https://commons.wikimedia.org/wiki/File:DeWalt_20_Volt_Max_Cordless_Drill.jpg" target="_blank" rel="noopener">Wikimedia Commons</a> / CC BY-SA 4.0</p>
    </div>
  </div>

  <section id="comparacoes" class="content-cards">
    <h2>Análises em destaque</h2>
    <div class="featured-card">
      <div class="featured-image">
        <img src="/images/dewalt-20v-cc.jpg" alt="DeWalt DCD777 analysis" loading="lazy" width="500" height="333" />
        <p class="image-credit-small">Foto: TaurusEmerald / Wikimedia Commons / CC BY-SA 4.0</p>
      </div>
      <div class="featured-content">
        <span class="card-category">ANÁLISE DE PRODUTO</span>
        <h3>DeWalt DCD777 vale a pena?</h3>
        <p>Especificações técnicas, características e análise baseada em dados do fabricante.</p>
        <a href="/parafusadeira-dewalt-dcd777-vale-a-pena/" class="card-cta">Ler análise completa →</a>
      </div>
    </div>
    <div class="secondary-cards">
      <a href="/bosch-ou-makita-parafusadeira/" class="card-compact">
        <div class="card-compact-image">
          <img src="/images/bosch-makita-cc.jpg" alt="Bosch vs Makita comparison" loading="lazy" width="300" height="200" />
          <p class="image-credit-compact">Foto: Hendrikp111 / Wikimedia Commons / CC BY-SA 4.0</p>
        </div>
        <div class="card-compact-content">
          <span class="card-category">COMPARAÇÃO DE MARCAS</span>
          <h3>Bosch ou Makita?</h3>
          <p>Comparação técnica entre as marcas: garantia, linhas de produto e compatibilidade.</p>
        </div>
      </a>
      <a href="/parafusadeira-12v-ou-18v/" class="card-compact">
        <div class="card-compact-image">
          <img src="/images/bosch-12v-cc.jpg" alt="12V vs 18V decision guide" loading="lazy" width="300" height="200" />
          <p class="image-credit-compact">Foto: Charles & Hudson / Wikimedia Commons / CC BY-SA 2.0</p>
        </div>
        <div class="card-compact-content">
          <span class="card-category">GUIA DE DECISÃO</span>
          <h3>12V ou 18V?</h3>
          <p>Diferenças de torque, peso, autonomia e quando escolher cada voltagem.</p>
        </div>
      </a>
    </div>
  </section>

  <section id="metodologia" class="methodology">
    <h2>Como analisamos</h2>
    <div class="methodology-steps">
      <div class="step">
        <div class="step-number">01</div>
        <div class="step-content">
          <h3>Especificações</h3>
          <p>Coletamos dados oficiais de fabricantes, manuais técnicos e fontes verificáveis.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">02</div>
        <div class="step-content">
          <h3>Comparação</h3>
          <p>Analisamos diferenças relevantes com fontes citadas e dados objetivos.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-number">03</div>
        <div class="step-content">
          <h3>Decisão</h3>
          <p>Mostramos para quem cada opção faz sentido, sem vencedor universal.</p>
        </div>
      </div>
    </div>
    <p class="methodology-disclaimer">Quando não testamos fisicamente um produto, deixamos isso explícito.</p>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
      align-items: center;
      margin-bottom: 5rem;
      padding: 3rem 0;
      background: var(--surface);
      margin-left: -1.5rem;
      margin-right: -1.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .eyebrow {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--amber);
      margin-bottom: 1.25rem;
      text-transform: uppercase;
    }

    .hero-content h1 {
      font-size: 2.5rem;
      line-height: 1.15;
      margin-top: 0;
      margin-bottom: 1.25rem;
      color: var(--ink);
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .hero-subtitle {
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 2rem;
      max-width: 100%;
    }

    .hero-trust {
      font-size: 0.8125rem;
      color: var(--steel);
      margin-top: 1.75rem;
      padding-top: 1.75rem;
      border-top: 2px solid var(--line);
      font-weight: 500;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .cta-primary,
    .cta-secondary {
      padding: 0.8125rem 1.625rem;
      font-weight: 600;
      border-radius: 4px;
      transition: all 0.2s;
      font-size: 0.9375rem;
      border: 2px solid transparent;
    }

    .cta-primary {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }

    .cta-primary:hover {
      background: transparent;
      color: var(--ink);
      text-decoration: none;
    }

    .cta-secondary {
      background: transparent;
      color: var(--ink);
      border-color: var(--line);
    }

    .cta-secondary:hover {
      border-color: var(--ink);
      text-decoration: none;
    }

    .hero-visual {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      position: relative;
    }

    .hero-visual img {
      width: 100%;
      height: auto;
      border: 1px solid var(--line);
      object-fit: cover;
    }

    .image-credit {
      font-size: 0.6875rem;
      color: var(--steel);
      margin: 0;
      line-height: 1.5;
    }

    .image-credit a {
      color: var(--steel);
      text-decoration: underline;
      text-decoration-color: var(--amber);
    }

    .content-cards {
      margin-bottom: 5rem;
      padding-top: 1rem;
    }

    .content-cards h2 {
      font-size: 1.875rem;
      margin-bottom: 2.75rem;
      margin-top: 0;
      font-weight: 700;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--line);
    }

    .featured-card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      background: var(--surface);
      border: 1px solid var(--line);
      padding: 0;
      margin-bottom: 3rem;
      overflow: hidden;
    }

    .featured-image {
      position: relative;
    }

    .featured-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .image-credit-small {
      font-size: 0.6875rem;
      color: var(--steel);
      position: absolute;
      bottom: 0.5rem;
      left: 0.5rem;
      background: rgba(255, 255, 255, 0.9);
      padding: 0.25rem 0.5rem;
      line-height: 1.3;
    }

    .featured-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2.5rem 2.5rem 2.5rem 0;
    }

    .secondary-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .card-compact {
      display: block;
      background: var(--surface);
      border-top: 3px solid var(--amber);
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 0;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s;
      overflow: hidden;
    }

    .card-compact:hover {
      border-top-color: var(--ink);
      text-decoration: none;
    }

    .card-compact-image {
      position: relative;
      height: 200px;
      overflow: hidden;
    }

    .card-compact-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .image-credit-compact {
      font-size: 0.625rem;
      color: var(--steel);
      position: absolute;
      bottom: 0.375rem;
      left: 0.5rem;
      background: rgba(255, 255, 255, 0.9);
      padding: 0.1875rem 0.375rem;
      line-height: 1.3;
    }

    .card-compact-content {
      padding: 1.75rem 1.5rem;
    }

    .card-category {
      display: inline-block;
      font-size: 0.625rem;
      font-weight: 700;
      color: var(--ink);
      background: transparent;
      padding: 0;
      margin-bottom: 0.625rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .featured-content h3,
    .card-compact-content h3 {
      margin-top: 0;
      margin-bottom: 0.875rem;
      font-size: 1.25rem;
      color: var(--ink);
      line-height: 1.3;
      font-weight: 700;
    }

    .featured-content p,
    .card-compact-content p {
      color: var(--muted);
      margin-bottom: 1.25rem;
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .card-cta {
      color: var(--ink);
      font-weight: 600;
      font-size: 0.875rem;
      text-decoration: none;
      border-bottom: 2px solid var(--amber);
      padding-bottom: 2px;
    }

    .card-cta:hover {
      border-bottom-color: var(--ink);
    }

    .methodology {
      background: var(--ink);
      padding: 3.5rem 3rem;
      margin-bottom: 3rem;
      margin-left: -1.5rem;
      margin-right: -1.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .methodology h2 {
      margin-top: 0;
      font-size: 1.875rem;
      margin-bottom: 3rem;
      color: var(--paper);
      font-weight: 700;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--steel);
    }

    .methodology-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
      margin-bottom: 2.5rem;
    }

    .step {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .step-number {
      font-size: 3rem;
      font-weight: 800;
      color: var(--amber);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .step-content h3 {
      margin-top: 0;
      margin-bottom: 0.625rem;
      font-size: 1.125rem;
      color: var(--paper);
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .step-content p {
      color: var(--steel);
      font-size: 0.875rem;
      margin: 0;
      line-height: 1.65;
    }

    .methodology-disclaimer {
      color: var(--steel);
      font-size: 0.8125rem;
      font-style: italic;
      margin: 0;
      padding-top: 2rem;
      border-top: 1px solid var(--steel);
      max-width: 100%;
    }

    @media (max-width: 1024px) {
      .secondary-cards {
        grid-template-columns: 1fr;
      }

      .methodology-steps {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 1.5rem 0;
        margin-bottom: 3rem;
      }

      .hero-content h1 {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1rem;
      }

      .featured-card {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .card-compact {
        grid-template-columns: 1fr;
      }

      .content-cards h2,
      .methodology h2 {
        font-size: 1.75rem;
      }

      .methodology {
        padding: 2.5rem 1.5rem;
      }
    }
  </style>
</BaseLayout>
