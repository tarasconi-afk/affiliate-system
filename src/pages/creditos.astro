<style>
  .credits-page { max-width: 980px; margin: 0 auto; padding: 5rem 1.5rem 2rem; }
  header { max-width: 720px; padding-bottom: 2.5rem; border-bottom: 2px solid var(--ink); }
  .kicker { margin: 0 0 1rem; color: var(--amber-dark); font-size: .68rem; font-weight: 900; letter-spacing: .16em; }
  h1 { margin: 0 0 1.2rem; font-size: clamp(2.6rem, 6vw, 4.6rem); }
  header > p:last-child { margin: 0; font-size: 1.02rem; line-height: 1.75; }
  .credits-list { margin-top: 1rem; }
  .credits-list section { display: grid; grid-template-columns: 56px 1fr; gap: 1.3rem; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .index { color: var(--amber-dark); font: 850 .72rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  h2 { margin: 0 0 1.1rem; font-size: 1.45rem; }
  dl { margin: 0; }
  dl > div { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: .5rem 0; }
  dt { color: var(--steel); font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  dd { margin: 0; color: var(--muted); }
  dd a { color: var(--ink); font-weight: 700; }
  .treatment { margin: 3rem 0 0; padding: 2rem; background: var(--ink-soft); border-left: 5px solid var(--amber); }
  .treatment h2 { color: var(--paper); }
  .treatment p { margin: 0; color: #c8ccce; line-height: 1.75; }
  @media (max-width: 560px) {
    .credits-page { padding: 3rem 1rem 1rem; }
    .credits-list section { grid-template-columns: 1fr; gap: .5rem; }
    dl > div { grid-template-columns: 1fr; gap: .15rem; }
  }
</style>
