---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #17191C;
    --paper: #F2EEE5;
    --surface: #FFFFFF;
    --amber: #E3A008;
    --steel: #687078;
    --line: #D5D0C6;
    --muted: #5F6368;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Helvetica Neue', sans-serif;
    line-height: 1.65;
    color: var(--ink);
    background: var(--paper);
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    width: 100%;
  }

  h1, h2, h3, h4, h5, h6 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  h1 {
    font-size: 2.25rem;
    margin-bottom: 1rem;
    font-weight: 800;
    line-height: 1.1;
  }

  h2 {
    font-size: 1.75rem;
    margin-top: 3rem;
    font-weight: 700;
  }

  h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    font-weight: 700;
  }

  p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    max-width: 75ch;
    color: var(--ink);
  }

  a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  a:hover {
    text-decoration-color: var(--ink);
  }

  ul, ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.875rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    h3 {
      font-size: 1.125rem;
    }

    main {
      padding: 0 1rem 2rem;
    }
  }
</style>
