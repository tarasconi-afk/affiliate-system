---
import BaseLayout from './BaseLayout.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EvidenceList from '../components/EvidenceList.astro';
import Sources from '../components/Sources.astro';
import type { PageSpec } from '../lib/types';

interface Props {
  pageSpec: PageSpec;
}

const { pageSpec } = Astro.props;
---

<BaseLayout title={pageSpec.metadata.title}>
  <Fragment slot="head">
    <SEOHead metadata={pageSpec.metadata} slug={pageSpec.slug} />
    <ArticleSchema
      metadata={pageSpec.metadata}
      slug={pageSpec.slug}
      product={pageSpec.type === 'model_review' ? pageSpec.product : undefined}
    />
    <BreadcrumbSchema breadcrumbs={pageSpec.metadata.breadcrumbs} currentSlug={pageSpec.slug} />
  </Fragment>

  <article class="article-content">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {pageSpec.metadata.breadcrumbs.map((crumb, idx) => (
        <Fragment>
          {idx > 0 && <span class="separator">›</span>}
          {crumb.url ? (
            <a href={crumb.url}>{crumb.name}</a>
          ) : (
            <span class="current">{crumb.name}</span>
          )}
        </Fragment>
      ))}
    </nav>

    <!-- Categoria -->
    <div class="article-category">
      {pageSpec.type === 'model_review' && 'ANÁLISE DE PRODUTO'}
      {pageSpec.type === 'brand_compare' && 'COMPARAÇÃO DE MARCAS'}
      {pageSpec.type === 'decision_compare' && 'GUIA DE DECISÃO'}
    </div>

    <!-- Hero -->
    <header class="article-header">
      <div class="article-header-content">
        <h1>{pageSpec.hero.heading}</h1>
        <p class="article-subtitle">{pageSpec.hero.subheading}</p>
      </div>
      {pageSpec.type === 'model_review' && pageSpec.slug === 'parafusadeira-dewalt-dcd777-vale-a-pena' && (
        <div class="article-visual">
          <img
            src="/images/dewalt-dcd777.webp"
            alt="DeWalt DCD777 - Parafusadeira/Furadeira 20V MAX Brushless"
            width="500"
            height="333"
            loading="eager"
          />
        </div>
      )}
      {pageSpec.type === 'brand_compare' && (
        <div class="article-visual brands-visual">
          <div class="brand-image">
            <img
              src="/images/bosch-tool.svg"
              alt="Bosch Professional"
              width="300"
              height="200"
            />
          </div>
          <div class="vs-divider">vs</div>
          <div class="brand-image">
            <img
              src="/images/makita-tool.svg"
              alt="Makita"
              width="300"
              height="200"
            />
          </div>
        </div>
      )}
      {pageSpec.type === 'decision_compare' && (
        <div class="article-visual voltage-visual">
          <div class="voltage-option">
            <img
              src="/images/voltage-12v.svg"
              alt="12V - Compacto e leve"
              width="200"
              height="140"
            />
          </div>
          <div class="voltage-option">
            <img
              src="/images/voltage-18v.svg"
              alt="18V - Potência máxima"
              width="200"
              height="140"
            />
          </div>
        </div>
      )}
    </header>

    <!-- Model Review -->
    {pageSpec.type === 'model_review' && (
      <section class="model-review">
        <div class="quick-answer">
          <h2>Resposta curta</h2>
          <p>
            A DeWalt DCD777 é uma parafusadeira/furadeira brushless 18V (20V MAX) com mandril de 13mm,
            adequada para uso doméstico e semiprofissional em materiais leves a médios.
          </p>
        </div>

        <div class="key-specs">
          <h2>Principais dados</h2>
          <div class="specs-grid">
            <div class="spec-card">
              <div class="spec-label">Motor</div>
              <div class="spec-value">Brushless</div>
            </div>
            <div class="spec-card">
              <div class="spec-label">Tensão</div>
              <div class="spec-value">18V (20V MAX)</div>
            </div>
            <div class="spec-card">
              <div class="spec-label">Mandril</div>
              <div class="spec-value">13 mm</div>
            </div>
            <div class="spec-card">
              <div class="spec-label">Velocidades</div>
              <div class="spec-value">2 marchas</div>
            </div>
          </div>
        </div>

        <h2>Especificações completas</h2>
        <table class="specs-table">
          <tbody>
            {pageSpec.specs.map(spec => (
              <tr class:list={{'highlight': spec.highlight}}>
                <th class="spec-label">{spec.label}</th>
                <td class="spec-value">
                  {spec.value}
                  <Sources evidenceIds={spec.evidenceIds} evidences={pageSpec.evidences} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {pageSpec.prosCons && (
          <div class="pros-cons">
            <div class="pros">
              <h3>Pontos Positivos</h3>
              <ul>
                {pageSpec.prosCons.pros.map(pro => (
                  <li>
                    {pro.text}
                    {pro.evidenceIds && <Sources evidenceIds={pro.evidenceIds} evidences={pageSpec.evidences} />}
                  </li>
                ))}
              </ul>
            </div>
            <div class="cons">
              <h3>Pontos Negativos</h3>
              <ul>
                {pageSpec.prosCons.cons.map(con => (
                  <li>
                    {con.text}
                    {con.evidenceIds && <Sources evidenceIds={con.evidenceIds} evidences={pageSpec.evidences} />}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}

        {pageSpec.faq && pageSpec.faq.length > 0 && (
          <section class="faq">
            <h2>Perguntas Frequentes</h2>
            {pageSpec.faq.map(item => (
              <div class="faq-item">
                <h3>{item.question}</h3>
                <p>
                  {item.answer}
                  {item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}
                </p>
              </div>
            ))}
          </section>
        )}
      </section>
    )}

    <!-- Brand Compare -->
    {pageSpec.type === 'brand_compare' && (
      <section class="brand-compare">
        <div class="brands-intro">
          <div class="brand">
            <h2>{pageSpec.brands[0].name}</h2>
            <p>
              {pageSpec.brands[0].summary}
              {pageSpec.brands[0].evidenceIds && <Sources evidenceIds={pageSpec.brands[0].evidenceIds} evidences={pageSpec.evidences} />}
            </p>
          </div>
          <div class="brand">
            <h2>{pageSpec.brands[1].name}</h2>
            <p>
              {pageSpec.brands[1].summary}
              {pageSpec.brands[1].evidenceIds && <Sources evidenceIds={pageSpec.brands[1].evidenceIds} evidences={pageSpec.evidences} />}
            </p>
          </div>
        </div>

        <h2>Comparação</h2>
        <ComparisonTable
          dimensions={pageSpec.comparison.dimensions}
          label1={pageSpec.brands[0].name}
          label2={pageSpec.brands[1].name}
        />

        {pageSpec.verdict && (
          <section class="verdict">
            <h2>Qual escolher?</h2>
            <div class="verdict-content">
              <p class="verdict-summary">
                <strong>{pageSpec.verdict.summary}</strong>
                {pageSpec.verdict.evidenceIds && <Sources evidenceIds={pageSpec.verdict.evidenceIds} evidences={pageSpec.evidences} />}
              </p>
              <p class="verdict-recommendation">{pageSpec.verdict.recommendation}</p>
            </div>
          </section>
        )}

        {pageSpec.faq && pageSpec.faq.length > 0 && (
          <section class="faq">
            <h2>Perguntas Frequentes</h2>
            {pageSpec.faq.map(item => (
              <div class="faq-item">
                <h3>{item.question}</h3>
                <p>
                  {item.answer}
                  {item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}
                </p>
              </div>
            ))}
          </section>
        )}
      </section>
    )}

    <!-- Decision Compare -->
    {pageSpec.type === 'decision_compare' && (
      <section class="decision-compare">
        <div class="options-intro">
          <div class="option">
            <h2>{pageSpec.options[0].name}</h2>
            <p>
              {pageSpec.options[0].description}
              {pageSpec.options[0].evidenceIds && <Sources evidenceIds={pageSpec.options[0].evidenceIds} evidences={pageSpec.evidences} />}
            </p>
          </div>
          <div class="option">
            <h2>{pageSpec.options[1].name}</h2>
            <p>
              {pageSpec.options[1].description}
              {pageSpec.options[1].evidenceIds && <Sources evidenceIds={pageSpec.options[1].evidenceIds} evidences={pageSpec.evidences} />}
            </p>
          </div>
        </div>

        <h2>Comparação</h2>
        <ComparisonTable
          dimensions={pageSpec.comparison.dimensions}
          label1={pageSpec.options[0].name}
          label2={pageSpec.options[1].name}
        />

        {pageSpec.verdict && (
          <section class="verdict">
            <h2>Qual escolher?</h2>
            <div class="verdict-content">
              <p class="verdict-summary">
                <strong>{pageSpec.verdict.summary}</strong>
                {pageSpec.verdict.evidenceIds && <Sources evidenceIds={pageSpec.verdict.evidenceIds} evidences={pageSpec.evidences} />}
              </p>
              <p class="verdict-recommendation">{pageSpec.verdict.recommendation}</p>
            </div>
          </section>
        )}

        {pageSpec.faq && pageSpec.faq.length > 0 && (
          <section class="faq">
            <h2>Perguntas Frequentes</h2>
            {pageSpec.faq.map(item => (
              <div class="faq-item">
                <h3>{item.question}</h3>
                <p>
                  {item.answer}
                  {item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}
                </p>
              </div>
            ))}
          </section>
        )}
      </section>
    )}

    <!-- Evidence List (sempre presente) -->
    <EvidenceList evidences={pageSpec.evidences} />

    <!-- Monetization (opcional) -->
    {pageSpec.monetization?.affiliateUrl && (
      <section class="monetization">
        <a href={pageSpec.monetization.affiliateUrl} class="cta-button" target="_blank" rel="noopener noreferrer">
          {pageSpec.monetization.ctaText || 'Ver opções de compra'}
        </a>
        {pageSpec.monetization.disclaimer && (
          <p class="disclaimer">{pageSpec.monetization.disclaimer}</p>
        )}
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #9ca3af;
  }

  .breadcrumbs .separator {
    margin: 0 0.5rem;
    color: #d1d5db;
  }

  .breadcrumbs a {
    color: #6b7280;
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: #2563eb;
    text-decoration: none;
  }

  .breadcrumbs .current {
    color: #4b5563;
  }

  .article-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2563eb;
    background: #eff6ff;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .article-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .article-header-content {
    flex: 1;
  }

  .article-header h1 {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .article-subtitle {
    font-size: 1.25rem;
    color: #6b7280;
    margin-top: 0.75rem;
    line-height: 1.6;
    max-width: 100%;
  }

  .article-visual {
    flex-shrink: 0;
  }

  .article-visual img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .brands-visual {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #f9fafb;
    border-radius: 12px;
  }

  .brand-image {
    flex: 1;
  }

  .vs-divider {
    font-size: 1.25rem;
    font-weight: 700;
    color: #6b7280;
    padding: 0 1rem;
  }

  .voltage-visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #f9fafb;
    border-radius: 12px;
  }

  .voltage-option {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .quick-answer {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 3rem;
    border: 1px solid #bfdbfe;
  }

  .quick-answer h2 {
    margin-top: 0;
    font-size: 1.25rem;
    color: #1e40af;
    margin-bottom: 1rem;
  }

  .quick-answer p {
    color: #1e3a8a;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
    max-width: 100%;
  }

  .key-specs {
    margin-bottom: 3rem;
  }

  .key-specs h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }

  .spec-card {
    background: #f9fafb;
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }

  .spec-card .spec-label {
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .spec-card .spec-value {
    font-size: 1.125rem;
    color: #111827;
    font-weight: 600;
  }

  .specs-table {
    width: 100%;
    margin-bottom: 3rem;
    border-collapse: collapse;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
  }

  .specs-table tbody tr {
    border-bottom: 1px solid #f3f4f6;
  }

  .specs-table tbody tr:last-child {
    border-bottom: none;
  }

  .specs-table tbody tr:nth-child(even) {
    background-color: #fafbfc;
  }

  .specs-table tr.highlight {
    background-color: #fef3c7 !important;
  }

  .specs-table th,
  .specs-table td {
    padding: 1rem 1.25rem;
    text-align: left;
  }

  .specs-table .spec-label {
    font-weight: 600;
    width: 35%;
    color: #374151;
  }

  .specs-table .spec-value {
    width: 65%;
    color: #1f2937;
  }

  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 3rem 0;
  }

  .pros,
  .cons {
    padding: 1.75rem;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }

  .pros {
    background: #f0fdf4;
    border-left: 3px solid #16a34a;
  }

  .cons {
    background: #fef2f2;
    border-left: 3px solid #dc2626;
  }

  .pros h3 {
    color: #16a34a;
    margin-top: 0;
  }

  .cons h3 {
    color: #dc2626;
    margin-top: 0;
  }

  .brands-intro,
  .options-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 3rem 0;
  }

  .brand,
  .option {
    padding: 2rem;
    background-color: #f9fafb;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
  }

  .brand h2,
  .option h2 {
    margin-top: 0;
    font-size: 1.5rem;
  }

  .verdict {
    margin: 3rem 0;
    padding: 2.5rem;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    border-left: 4px solid #2563eb;
    border-radius: 12px;
    border: 1px solid #bfdbfe;
  }

  .verdict h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: #1e40af;
  }

  .verdict-summary {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #1e3a8a;
  }

  .verdict-recommendation {
    color: #1e3a8a;
    line-height: 1.7;
  }

  .faq {
    margin: 3rem 0;
  }

  .faq h2 {
    margin-bottom: 1.5rem;
  }

  .faq-item {
    margin-bottom: 1.5rem;
    padding: 1.75rem;
    background-color: white;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }

  .faq-item h3 {
    margin-top: 0;
    font-size: 1.125rem;
    color: #111827;
    margin-bottom: 0.75rem;
  }

  .faq-item p {
    margin-bottom: 0;
    color: #4b5563;
  }

  .monetization {
    margin-top: 4rem;
    padding: 2.5rem;
    background-color: #f9fafb;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #e5e7eb;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #2563eb;
    color: white;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cta-button:hover {
    background-color: #1d4ed8;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .disclaimer {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .article-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .article-visual {
      align-self: center;
    }

    .article-visual img {
      max-width: 280px;
    }

    .brands-visual {
      flex-direction: column;
      gap: 1rem;
    }

    .vs-divider {
      transform: rotate(90deg);
    }

    .voltage-visual {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pros-cons,
    .brands-intro,
    .options-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .specs-table {
      font-size: 0.9rem;
    }

    .specs-table th,
    .specs-table td {
      padding: 0.875rem 1rem;
    }

    .quick-answer,
    .verdict {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .specs-grid {
      grid-template-columns: 1fr;
    }

    .specs-table .spec-label,
    .specs-table .spec-value {
      display: block;
      width: 100%;
    }

    .specs-table .spec-label {
      padding-bottom: 0.25rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .specs-table .spec-value {
      padding-top: 0.5rem;
    }
  }
</style>
