---
import BaseLayout from './BaseLayout.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EvidenceList from '../components/EvidenceList.astro';
import Sources from '../components/Sources.astro';
import type { PageSpec } from '../lib/types';

interface Props { pageSpec: PageSpec; }
const { pageSpec } = Astro.props;
const updatedLabel = new Date(pageSpec.metadata.updatedAt).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---

<BaseLayout title={pageSpec.metadata.title}>
  <Fragment slot="head">
    <SEOHead metadata={pageSpec.metadata} slug={pageSpec.slug} />
    <ArticleSchema metadata={pageSpec.metadata} slug={pageSpec.slug} product={pageSpec.type === 'model_review' ? pageSpec.product : undefined} />
    <BreadcrumbSchema breadcrumbs={pageSpec.metadata.breadcrumbs} currentSlug={pageSpec.slug} />
  </Fragment>

  <article class="article-shell">
    <div class="article-topline">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {pageSpec.metadata.breadcrumbs.map((crumb, idx) => (
          <Fragment>
            {idx > 0 && <span aria-hidden="true">/</span>}
            {crumb.url ? <a href={crumb.url}>{crumb.name}</a> : <span>{crumb.name}</span>}
          </Fragment>
        ))}
      </nav>
      <span class="updated">Atualizado em {updatedLabel}</span>
    </div>

    <header class="article-hero">
      <div class="hero-copy">
        <p class="article-category">
          {pageSpec.type === 'model_review' && 'ANÁLISE DE MODELO'}
          {pageSpec.type === 'brand_compare' && 'COMPARAÇÃO DE MARCAS'}
          {pageSpec.type === 'decision_compare' && 'GUIA DE DECISÃO'}
        </p>
        <h1>{pageSpec.hero.heading}</h1>
        <p class="article-subtitle">{pageSpec.hero.subheading}</p>
        <div class="method-note">
          <strong>Como esta análise foi feita</strong>
          <span>Usamos especificações e documentação pública. Quando não há teste prático, isso é informado explicitamente.</span>
        </div>
      </div>

      {pageSpec.type === 'model_review' && (
        <figure class="article-figure">
          <img src="/images/dewalt-20v-cc-1600.webp" alt="Ferramenta DeWalt 20V usada como imagem editorial ilustrativa" width="1400" height="1400" loading="eager" />
          <figcaption><strong>Imagem ilustrativa.</strong> A foto mostra uma ferramenta DeWalt 20V; o modelo analisado é a DCD7771D2-BR.</figcaption>
        </figure>
      )}

      {pageSpec.type === 'brand_compare' && (
        <figure class="article-figure brand-figure">
          <img src="/images/bosch-makita-cc-1600.webp" alt="Ferramentas Bosch e Makita reunidas em uma comparação editorial" width="1600" height="739" loading="eager" />
          <span class="figure-label" aria-hidden="true">BOSCH / MAKITA</span>
        </figure>
      )}

      {pageSpec.type === 'decision_compare' && (
        <figure class="article-figure voltage-figure">
          <div class="voltage-image"><img src="/images/bosch-12v-cc-1600.webp" alt="Exemplo visual de ferramenta Bosch 12V" width="1600" height="1071" loading="eager" /><b>12V</b></div>
          <div class="voltage-image"><img src="/images/makita-lxt-18v-cc-1600.webp" alt="Exemplo visual de ferramenta Makita 18V" width="1200" height="1600" loading="eager" /><b>18V</b></div>
          <figcaption>Exemplos visuais das categorias, não uma comparação direta entre esses dois modelos.</figcaption>
        </figure>
      )}
    </header>

    <div class="article-body">
      {pageSpec.type === 'model_review' && (
        <section class="model-review">
          <aside class="quick-answer" aria-labelledby="veredito-rapido">
            <p class="block-label">RESPOSTA CURTA</p>
            <h2 id="veredito-rapido">Veredito rápido</h2>
            <p>A DCD7771D2-BR combina motor brushless, torque máximo informado de 65 Nm, duas faixas de rotação e mandril de 13 mm. O kit brasileiro inclui duas baterias de 2 Ah e carregador bivolt. É uma opção coerente para quem procura uma furadeira/parafusadeira compacta sem função impacto.</p>
          </aside>

          <section class="fact-strip" aria-labelledby="trinta-segundos">
            <div class="fact-strip-heading"><span>FC / DADOS</span><h2 id="trinta-segundos">Em 30 segundos</h2></div>
            <div class="facts">
              <div><span>Torque</span><strong>65 Nm</strong></div>
              <div><span>Rotação</span><strong>0–500 / 0–1.750 RPM</strong></div>
              <div><span>Mandril</span><strong>13 mm</strong></div>
              <div><span>Motor</span><strong>Brushless</strong></div>
            </div>
          </section>

          <section class="content-section">
            <h2>Especificações verificadas</h2>
            <div class="table-scroll">
              <table class="specs-table">
                <tbody>
                  {pageSpec.specs.map(spec => (
                    <tr class:list={{ highlight: spec.highlight }}>
                      <th>{spec.label}</th>
                      <td>{spec.value}<Sources evidenceIds={spec.evidenceIds} evidences={pageSpec.evidences} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {pageSpec.prosCons && (
            <section class="content-section pros-cons">
              <div class="pros"><p class="block-label">PONTOS A FAVOR</p><h2>Onde faz sentido</h2><ul>{pageSpec.prosCons.pros.map(item => <li>{item.text}{item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}</li>)}</ul></div>
              <div class="cons"><p class="block-label">ATENÇÃO</p><h2>O que considerar</h2><ul>{pageSpec.prosCons.cons.map(item => <li>{item.text}{item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}</li>)}</ul></div>
            </section>
          )}

          {pageSpec.faq && pageSpec.faq.length > 0 && (
            <section class="faq content-section"><h2>Perguntas frequentes</h2>{pageSpec.faq.map(item => <div class="faq-item"><h3>{item.question}</h3><p>{item.answer}{item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}</p></div>)}</section>
          )}
        </section>
      )}

      {pageSpec.type === 'brand_compare' && (
        <section class="brand-compare">
          <section class="decision-box" aria-labelledby="qual-marca">
            <p class="block-label">RESPOSTA PRIMEIRO</p>
            <h2 id="qual-marca">Qual faz mais sentido para você?</h2>
            <div class="decision-columns">
              <div><span class="decision-name">{pageSpec.brands[0].name}</span><p>{pageSpec.brands[0].summary}{pageSpec.brands[0].evidenceIds && <Sources evidenceIds={pageSpec.brands[0].evidenceIds} evidences={pageSpec.evidences} />}</p></div>
              <div><span class="decision-name">{pageSpec.brands[1].name}</span><p>{pageSpec.brands[1].summary}{pageSpec.brands[1].evidenceIds && <Sources evidenceIds={pageSpec.brands[1].evidenceIds} evidences={pageSpec.evidences} />}</p></div>
            </div>
          </section>

          <section class="content-section"><h2>Comparação por critério</h2><ComparisonTable dimensions={pageSpec.comparison.dimensions} label1={pageSpec.brands[0].name} label2={pageSpec.brands[1].name} /></section>

          {pageSpec.verdict && <section class="verdict content-section"><p class="block-label">LEITURA EDITORIAL</p><h2>Como decidir</h2><p class="verdict-summary">{pageSpec.verdict.summary}{pageSpec.verdict.evidenceIds && <Sources evidenceIds={pageSpec.verdict.evidenceIds} evidences={pageSpec.evidences} />}</p><p>{pageSpec.verdict.recommendation}</p></section>}

          {pageSpec.faq && pageSpec.faq.length > 0 && <section class="faq content-section"><h2>Perguntas frequentes</h2>{pageSpec.faq.map(item => <div class="faq-item"><h3>{item.question}</h3><p>{item.answer}{item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}</p></div>)}</section>}
        </section>
      )}

      {pageSpec.type === 'decision_compare' && (
        <section class="decision-compare">
          <section class="decision-box" aria-labelledby="escolha-rapida">
            <p class="block-label">DECISÃO RÁPIDA</p>
            <h2 id="escolha-rapida">Escolha em 10 segundos</h2>
            <div class="decision-columns">
              <div><span class="decision-name">12V</span><p>{pageSpec.options[0].description}{pageSpec.options[0].evidenceIds && <Sources evidenceIds={pageSpec.options[0].evidenceIds} evidences={pageSpec.evidences} />}</p></div>
              <div><span class="decision-name">18V</span><p>{pageSpec.options[1].description}{pageSpec.options[1].evidenceIds && <Sources evidenceIds={pageSpec.options[1].evidenceIds} evidences={pageSpec.evidences} />}</p></div>
            </div>
          </section>

          <section class="content-section"><h2>Comparação por critério</h2><ComparisonTable dimensions={pageSpec.comparison.dimensions} label1={pageSpec.options[0].name} label2={pageSpec.options[1].name} /></section>

          {pageSpec.verdict && <section class="verdict content-section"><p class="block-label">LEITURA EDITORIAL</p><h2>Como decidir</h2><p class="verdict-summary">{pageSpec.verdict.summary}{pageSpec.verdict.evidenceIds && <Sources evidenceIds={pageSpec.verdict.evidenceIds} evidences={pageSpec.evidences} />}</p><p>{pageSpec.verdict.recommendation}</p></section>}

          {pageSpec.faq && pageSpec.faq.length > 0 && <section class="faq content-section"><h2>Perguntas frequentes</h2>{pageSpec.faq.map(item => <div class="faq-item"><h3>{item.question}</h3><p>{item.answer}{item.evidenceIds && <Sources evidenceIds={item.evidenceIds} evidences={pageSpec.evidences} />}</p></div>)}</section>}
        </section>
      )}

      <EvidenceList evidences={pageSpec.evidences} />

      {pageSpec.monetization?.affiliateUrl && <section class="monetization"><a href={pageSpec.monetization.affiliateUrl} target="_blank" rel="noopener noreferrer">{pageSpec.monetization.ctaText || 'Ver opções de compra'}</a>{pageSpec.monetization.disclaimer && <p>{pageSpec.monetization.disclaimer}</p>}</section>}
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell { max-width: var(--max); margin: 0 auto; padding: 1.4rem 1.5rem 0; }
  .article-topline { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .8rem 0 1.1rem; border-bottom: 1px solid var(--line); font-size: .72rem; color: var(--steel); }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; align-items: center; }
  .breadcrumbs a { color: var(--steel); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--ink); }
  .updated { white-space: nowrap; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; }

  .article-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 4rem; align-items: center; padding: 3.5rem 0 3rem; border-bottom: 2px solid var(--ink); }
  .article-category, .block-label { margin: 0 0 1rem; color: var(--amber-dark); font-size: .66rem; font-weight: 900; letter-spacing: .15em; }
  .article-hero h1 { margin: 0; font-size: clamp(2.4rem, 4.35vw, 4.2rem); max-width: 16ch; text-wrap: balance; overflow-wrap: normal; hyphens: none; }
  .article-subtitle { font-size: 1.06rem; line-height: 1.65; max-width: 54ch; margin: 1.25rem 0 0; }
  .method-note { margin-top: 1.6rem; padding-left: 1rem; border-left: 3px solid var(--amber); display: grid; gap: .2rem; max-width: 55ch; }
  .method-note strong { font-size: .78rem; }
  .method-note span { color: var(--muted); font-size: .76rem; line-height: 1.5; }

  .article-figure { margin: 0; position: relative; }
  .article-figure img { width: 100%; max-height: 500px; aspect-ratio: 1.08 / 1; object-fit: cover; object-position: 50% 52%; display: block; filter: saturate(.9) contrast(1.04); }
  .article-figure figcaption { margin-top: .6rem; color: var(--steel); font-size: .65rem; line-height: 1.45; }
  .figure-label { position: absolute; left: 0; bottom: 2rem; background: var(--ink); color: var(--paper); border-left: 5px solid var(--amber); padding: .55rem .7rem; font: 850 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; }
  .brand-figure img { aspect-ratio: 1.35 / 1; }

  .voltage-figure { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .voltage-image { position: relative; overflow: hidden; background: var(--ink); }
  .voltage-image img { aspect-ratio: 1 / 1; height: 100%; }
  .voltage-image b { position: absolute; left: .65rem; bottom: .65rem; background: var(--amber); color: var(--ink); padding: .45rem .55rem; font: 900 .75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .voltage-figure figcaption { grid-column: 1 / -1; }

  .article-body { max-width: 920px; margin: 0 auto; padding-top: 3rem; }
  .content-section { margin: 4rem 0; }
  .content-section > h2, .faq > h2 { margin: 0 0 1.4rem; padding-bottom: .8rem; border-bottom: 1px solid var(--line); }

  .quick-answer { margin: 0 0 3.5rem; background: var(--ink); color: var(--paper); padding: 2.2rem 2.4rem; border-top: 5px solid var(--amber); }
  .quick-answer .block-label { color: var(--amber); }
  .quick-answer h2 { color: var(--paper); margin: 0 0 .8rem; font-size: 1.75rem; }
  .quick-answer p { color: #d5d7d6; margin: 0; font-size: 1.02rem; line-height: 1.7; }

  .fact-strip { margin: 3.5rem 0 4rem; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
  .fact-strip-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .fact-strip-heading span { color: var(--steel); font: 800 .65rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .09em; }
  .fact-strip h2 { margin: 0; font-size: 1.35rem; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); }
  .facts > div { padding: 1.2rem 1rem 1.35rem 0; }
  .facts > div + div { border-left: 1px solid var(--line); padding-left: 1rem; }
  .facts span { display: block; color: var(--steel); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .35rem; }
  .facts strong { display: block; font-size: .96rem; line-height: 1.3; }

  .table-scroll { overflow-x: auto; }
  .specs-table { width: 100%; min-width: 560px; border-collapse: collapse; background: transparent; }
  .specs-table tr { border-bottom: 1px solid var(--line); }
  .specs-table tr:first-child { border-top: 2px solid var(--ink); }
  .specs-table th, .specs-table td { padding: 1rem .75rem; text-align: left; vertical-align: top; }
  .specs-table th { width: 34%; color: var(--steel); font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
  .specs-table td { font-weight: 650; color: var(--ink); }
  .specs-table tr.highlight td { color: var(--amber-dark); }

  .pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
  .pros-cons > div { padding: 2rem 2rem 2rem 0; }
  .pros-cons > div + div { border-left: 1px solid var(--line); padding-left: 2rem; padding-right: 0; }
  .pros-cons h2 { border: 0; padding: 0; margin: 0 0 1rem; font-size: 1.55rem; }
  .pros-cons ul { margin: 0; padding-left: 1.15rem; }
  .pros-cons li { margin: 0 0 .8rem; color: var(--muted); }

  .decision-box { margin: 0 0 4rem; border-top: 5px solid var(--amber); background: var(--paper-deep); padding: 2.25rem; }
  .decision-box h2 { margin: 0 0 1.5rem; font-size: clamp(1.6rem, 3vw, 2.35rem); }
  .decision-columns { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .decision-columns > div { padding: 1.5rem 1.6rem 0 0; }
  .decision-columns > div + div { border-left: 1px solid var(--line); padding-left: 1.6rem; padding-right: 0; }
  .decision-name { display: inline-block; font-weight: 900; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); margin-bottom: .55rem; }
  .decision-columns p { margin: 0; line-height: 1.7; }

  .verdict { background: var(--ink-soft); color: var(--paper); padding: 2.25rem; border-left: 5px solid var(--amber); }
  .verdict .block-label { color: var(--amber); }
  .verdict h2 { color: var(--paper); border-color: #4d5358; }
  .verdict p { color: #c8ccce; }
  .verdict-summary { color: var(--paper) !important; font-weight: 650; font-size: 1.05rem; }

  .faq-item { padding: 1.35rem 0 1.5rem; border-top: 1px solid var(--line); }
  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  .faq-item h3 { margin: 0 0 .55rem; font-size: 1.08rem; letter-spacing: -.015em; }
  .faq-item p { margin: 0; line-height: 1.7; }

  .monetization { margin: 4rem 0; padding: 1.5rem; border: 1px solid var(--line); }
  .monetization a { display: inline-block; background: var(--ink); color: var(--paper); padding: .8rem 1rem; text-decoration: none; font-weight: 800; }

  @media (max-width: 900px) {
    .article-hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 2.5rem; }
    .article-hero h1 { max-width: 17ch; }
    .article-figure { max-width: 720px; }
  }

  @media (max-width: 700px) {
    .article-shell { padding: 1rem 1rem 0; }
    .article-topline { align-items: flex-start; flex-direction: column; gap: .5rem; }
    .article-hero { padding: 2rem 0 2.25rem; }
    .article-hero h1 { font-size: clamp(2.25rem, 12vw, 3.3rem); }
    .article-body { padding-top: 2.25rem; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts > div:nth-child(3) { border-left: 0; border-top: 1px solid var(--line); }
    .facts > div:nth-child(4) { border-top: 1px solid var(--line); }
    .pros-cons, .decision-columns { grid-template-columns: 1fr; }
    .pros-cons > div + div, .decision-columns > div + div { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .quick-answer, .decision-box, .verdict { padding: 1.6rem; }
  }

  @media (max-width: 480px) {
    .voltage-figure { grid-template-columns: 1fr; }
    .voltage-figure figcaption { grid-column: auto; }
    .facts { grid-template-columns: 1fr; }
    .facts > div + div { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
  }
</style>
